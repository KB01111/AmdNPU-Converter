{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NPU Model Converter",
  "version": "0.1.0",
  "identifier": "com.amd.npu-converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "NPU Model Converter",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AMD NPU Model Converter",
    "longDescription": "Convert Hugging Face models to AMD NPU via ONNX and WinML/DirectML."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
