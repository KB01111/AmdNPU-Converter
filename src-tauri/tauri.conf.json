{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NPU Model Converter",
  "version": "0.1.0",
  "identifier": "com.amd.npu-converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NPU Model Converter",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../workers/download.py": "workers/download.py",
      "../workers/prepare_onnx.py": "workers/prepare_onnx.py",
      "../workers/bootstrap.ps1": "workers/bootstrap.ps1",
      "../workers/pyproject.toml": "workers/pyproject.toml",
      "../workers/README.md": "workers/README.md",
      "../workers/requirements-winml.txt": "workers/requirements-winml.txt",
      "../workers/requirements-quark.txt": "workers/requirements-quark.txt",
      "../workers/hf-inspector/inspect.py": "workers/hf-inspector/inspect.py",
      "../workers/winml/run.py": "workers/winml/run.py",
      "../workers/quark/quantize.py": "workers/quark/quantize.py",
      "../workers/evaluation/bench.py": "workers/evaluation/bench.py",
      "../workers/evaluation/compare.py": "workers/evaluation/compare.py",
      "../workers/exporters/common.py": "workers/exporters/common.py",
      "../workers/exporters/transformers/export_hf.py": "workers/exporters/transformers/export_hf.py",
      "../workers/exporters/cua-s1/export_cua_s1.py": "workers/exporters/cua-s1/export_cua_s1.py",
      "../workers/exporters/generic-onnx/convert.py": "workers/exporters/generic-onnx/convert.py",
      "../recipes/": "recipes/"
    },
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AMD NPU Model Converter",
    "longDescription": "Convert Hugging Face models to AMD NPU via ONNX and WinML/DirectML."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
